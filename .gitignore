# macOS resource fork / AppleDouble files (created by Mountain Duck / SFTP mounts)
._*
.DS_Store

# R temporary target objects
tmp_obj_*

# R session files
.Rhistory
.Rapp.history
.RData
.Ruserdata

# RStudio files
.Rproj.user/

# Targets workflow - track meta/meta for pipeline state
_targets/objects/
_targets/user/
_targets/workspaces/

# Data directories
data/temp/
data/other_data/
data/raw_data/
data/manual_download/*.gpkg
data/manual_download/NVM*
data/raw*
_targets/cache/
data/target_outputs/

# Terra auxiliary files (from terra_preserve_metadata)
*.tif.aux.xml
*.tif.zip
*.ovr

# Secrets & credentials
.Renviron
.httr-oauth
~/.boxr-oauth
.secrets
secrets/
debugging_auth.R

# JSON files - specific patterns only
secrets/*.json
scratch_code/*.json

# AppEEARS/NASA downloads
*.hdf
*.h5

# Test scripts
test_*.R

# R package build
*-Ex.R
/*.tar.gz
/*.Rcheck/

# Vignettes
vignettes/*.html
vignettes/*.pdf

# knitr and R markdown
*_cache/
/cache/
*.utf8.md
*.knit.md
index.md
index_files/

# Output/legacy directories
processed_data/
firemodel_predict

# Image outputs
img/*_files
img/*.html
img/network*

# OS files
.DS_Store
