{
  "name": "emma_envdata",
  "image": "adamwilsonlab/emma:latest",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  // Mount host ~/.Rprofile into the container so R credentials (Earthdata, etc.) are available automatically
  "mounts": [
    "source=${localEnv:HOME}/.Rprofile,target=/home/rstudio/.Rprofile,type=bind,readonly"
  ],
  // Pass Cline/VS Code API key from host shell env (~/.zshrc: export ANTHROPIC_API_KEY="sk-ant-xxxx")
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "saoudrizwan.claude-dev",
        "REditorSupport.r",
        "RDebugger.r-debugger",
        "quarto.quarto",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "github.vscode-github-actions",
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "R": {
            "path": "R",
            "args": ["--no-save", "--no-restore"],
            "icon": "symbol-misc"
          },
          "bash": {
            "path": "/bin/bash",
            "icon": "terminal-bash"
          }
        }
      }
    }
  }
}
